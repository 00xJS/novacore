# Unity — Asset meta data should be committed for tracked assets;
# never ignore *.meta globally.

# Unity/Mono native crash dumps (batch-mode shutdown crashes on macOS 27)
mono_crash.*.json

# CI projects for the engine-free tests (ci/) — kept, unlike Unity's generated ones
!ci/**/*.csproj
ci/**/bin/
ci/**/obj/

# iCloud Drive conflict copies ("Name 2.cs", "Name.cs 2.meta", "Settings 3.asset",
# ".gitignore 2"): the repo lives in a synced Desktop folder, and a copy that
# slips into a commit breaks the build with duplicate classes.
* [0-9].*
* [0-9]
* [0-9][0-9].*
* [0-9][0-9]
